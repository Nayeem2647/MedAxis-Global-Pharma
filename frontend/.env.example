# Express origin only; endpoint paths already include /v1. Required in every environment.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Optional private origin for server-side REST calls. Never use a NEXT_PUBLIC_ prefix.
# API_INTERNAL_BASE_URL=http://backend:4000
NEXT_PUBLIC_SITE_URL=https://medaxisglobalpharma.com
# Exact browser origin for admin BFF checks; defaults to NEXT_PUBLIC_SITE_URL.
# For local admin use this must match Express PUBLIC_ORIGIN.
# ADMIN_FRONTEND_ORIGIN=http://localhost:3000
# Optional additional HTTPS public asset origin (no bucket credentials).
# NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://assets.example.r2.dev
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Upload ownership uses a SameSite=Strict HttpOnly API cookie. Keep frontend/API
# on compatible same-site HTTPS origins (for example www.example.com/api.example.com).
# Locally use localhost for BOTH, or 127.0.0.1 for BOTH; do not mix them.
# Express PUBLIC_ORIGIN must include the frontend origin and credentialed CORS.
# Never put CLOUDFLARE_TURNSTILE_SECRET or prescription storage keys here.
# Official public contact details; WhatsApp supplied by the site owner.
NEXT_PUBLIC_WHATSAPP_NUMBER=+8801560066410
NEXT_PUBLIC_WECHAT_ID=
# Owner-supplied original QR; local /images/ assets or the configured public CDN/R2.
NEXT_PUBLIC_WECHAT_QR_URL=/images/wechat-contact.jpeg
NEXT_PUBLIC_CONTACT_EMAIL=
# Analytics is disabled until both values are set. Use your Plausible installation snippet.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=
# Optional separate HTTPS origin used by a proxied analytics collector (CSP).
NEXT_PUBLIC_PLAUSIBLE_API_HOST=
# Must match Express REVALIDATE_WEBHOOK_SECRET. Use a long random secret.
REVALIDATE_WEBHOOK_SECRET=
NEXT_TELEMETRY_DISABLED=1
