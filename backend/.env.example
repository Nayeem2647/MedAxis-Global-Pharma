# --- Core (required in every environment) ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# MongoDB Atlas (or a local replica set). Transactions require a replica set.
MONGODB_URI=mongodb://127.0.0.1:27017/medaxis?replicaSet=rs0
# Comma-separated allowlist of frontend origins (CORS, credentials enabled).
PUBLIC_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
# Signs cookies. Minimum 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_SESSION_SECRET=change-me-to-a-random-string-of-at-least-32-characters
# Use the same 32-byte base64 key and key ID used by the admin bootstrap seed.
# Required in production. Never derive this key from ADMIN_SESSION_SECRET.
TOTP_ENCRYPTION_KEY_BASE64=
TOTP_KEY_ID=
ADMIN_HOME_COUNTRY=BD

# --- Database behaviour (optional) ---
DB_CONNECT_RETRIES=5
DB_CONNECT_RETRY_DELAY_MS=2000
# Defaults to true in production. Set false only for local standalone MongoDB.
DB_REQUIRE_REPLICA_SET=false
# Defaults to true in production (honour cf-connecting-ip only when behind Cloudflare).
TRUST_CLOUDFLARE_HEADERS=false

# --- Required in production, optional in development/test ---
# 32-byte AES-256-GCM key as 64 hex chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PRESCRIPTION_ENCRYPTION_KEY=
PRESCRIPTION_KEY_ID=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PRODUCTS=
R2_BUCKET_QUOTES=
R2_BUCKET_PRESCRIPTIONS=
R2_PUBLIC_BASE_URL=
CLOUDFLARE_TURNSTILE_SECRET=
RESEND_API_KEY=
BREVO_API_KEY=
EMAIL_FALLBACK_ENABLED=false
EMAIL_REPLY_TO=
# Domain configured to route reply+<thread UUID> to the inbound HMAC webhook adapter.
EMAIL_REPLY_DOMAIN=
EMAIL_FROM=
EXCHANGE_RATE_API_KEY=
# Optional system Chromium override; otherwise Puppeteer's installed browser is used.
PUPPETEER_EXECUTABLE_PATH=
# Separate 32-byte hex/base64 key for encrypted, temporary quotation email links.
# Required to send/resend quotes. Keep outside MongoDB and separate from session signing.
QUOTATION_TOKEN_ENCRYPTION_KEY=
QUOTATION_TOKEN_KEY_ID=
REVALIDATE_WEBHOOK_SECRET=
WEBHOOK_HMAC_SECRET=
ADMIN_ALERT_EMAIL=

# --- One-time Single Super Admin bootstrap (npm run migrate, then npm run seed) ---
# Leave credentials out of version control. Existing singleton credentials are preserved.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Base32 secret already enrolled in the administrator's authenticator.
SEED_ADMIN_TOTP_SECRET=
# Separate 32-byte key, base64 encoded; keep outside MongoDB.
SEED_TOTP_ENCRYPTION_KEY_BASE64=
SEED_TOTP_KEY_ID=
# JSON array of bcrypt hashes; retain the corresponding backup codes offline.
SEED_ADMIN_BACKUP_CODE_HASHES=
