{
  "name": "medaxis-global-pharma-backend",
  "version": "1.0.0",
  "description": "MedAxis Global Pharma — Express.js TypeScript layered monolith API (Release 1)",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.integration.config.ts",
    "test:auth": "vitest run --config vitest.integration.config.ts tests/auth.integration.ts",
    "test:catalog": "vitest run --config vitest.integration.config.ts tests/catalog.integration.ts",
    "test:rfq": "vitest run --config vitest.integration.config.ts tests/rfq.integration.ts",
    "test:quotation": "vitest run --config vitest.integration.config.ts tests/quotation.integration.ts",
    "test:decisions": "vitest run --config vitest.integration.config.ts tests/decisions.integration.ts",
    "test:workers": "vitest run --config vitest.integration.config.ts tests/workers.integration.ts",
    "test:release": "npm run typecheck && npm run build && npm run lint && npm test && npm run test:db && npm run test:pdf",
    "test:pdf": "vitest run --config vitest.pdf.config.ts",
    "fonts:copy": "tsx src/scripts/copyPdfFonts.ts",
    "test:watch": "vitest",
    "migrate": "tsx src/scripts/migrate.ts",
    "migrate:storage": "tsx src/scripts/migrate-storage.ts",
    "seed": "tsx src/scripts/seed.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/geoip-lite": "^1.4.4",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.2",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^7.2.1",
    "ajv": "^6.15.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "pdfjs-dist": "^6.5.438",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "argon2": "^0.45.2",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "file-type": "^21.3.2",
    "geoip-lite": "^2.0.3",
    "helmet": "^8.3.0",
    "lossless-json": "^4.3.3",
    "mongoose": "^9.12.1",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "puppeteer": "^25.17.0",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.18.2",
    "speakeasy": "^2.0.0",
    "uuid": "^14.0.3",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  }
}
